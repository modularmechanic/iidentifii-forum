{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Database": {
    "SeedOnStartup": true
  },
  "RateLimiting": {
    "GlobalPermitsPerMinute": 600,
    "AuthenticationPermitsPerMinute": 100
  },
  "Tokens": {
    "Pepper": "development-only-pepper-not-for-any-real-deployment"
  }
}
